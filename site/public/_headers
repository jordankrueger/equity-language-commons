/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Static media. These filenames are not content-hashed, so they are replaced in
# place rather than versioned -- hence a day of caching plus a week of
# stale-while-revalidate, not `immutable`. A returning visitor stops re-fetching
# the 1.1 MB launch video; a replaced file still propagates within a day.
/media/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/og.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
