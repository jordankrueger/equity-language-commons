---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import glossaryData from "../../data/glossary-index.json";

const { stats, by_letter, rows, aliases_by_commons_slug } = glossaryData as {
  generated_at: string;
  stats: {
    total_terms: number;
    commons_terms: number;
    verified_hold_terms: number;
    curated_terms: number;
    listed_terms: number;
    long_tail_terms: number;
    visible_rows: number;
    visible_commons_rows: number;
    visible_long_tail_rows: number;
    visible_canonical_rows: number;
    visible_listed_rows: number;
    by_coverage: Record<string, number>;
  };
  by_letter: Record<string, string[]>;
  rows: Record<
    string,
    {
      term: string;
      display: string;
      source_count: number;
      commons_slug: string | null;
      tier: "full" | "verified-hold" | "curated" | "listed";
      provenance: "verified" | "machine-extracted" | null;
      canonical_source: {
        source_slug: string;
        page_slug: string;
        org: string;
        year: string;
        source_page_url: string;
        live_status: string;
      } | null;
      canonical_archived: boolean;
      excerpt: string | null;
      note: string | null;
      sources: Array<{
        source_slug: string;
        org: string;
        year: string;
        source_url: string;
        excerpt: string;
        extraction_method: string;
      }>;
    }
  >;
  aliases_by_commons_slug: Record<string, Array<{
    term: string;
    display: string;
    source_count: number;
    sources: Array<{ source_slug: string; org: string; year: string; source_url: string; excerpt: string; extraction_method: string }>;
  }>>;
};

const letters = Object.keys(by_letter);
const populatedLetters = new Set(letters);
const A_TO_Z = "abcdefghijklmnopqrstuvwxyz".split("");
const navLetters = [...A_TO_Z, "#"];
---

<BaseLayout
  title="Glossary index"
  description="Every term found in any source guide, A-Z. Cross-references the full corpus including the long-tail of single-source entries."
  mainClass="wide"
  pagefind
>
  <Breadcrumb trail={[{ href: "/", label: "Home" }, { label: "Glossary" }]} />
  <h1>Glossary</h1>
  <p class="subtitle">
    Every corpus term appears either as a primary entry or as an alias beneath one. Terms with cross-source treatment in <strong>three or more</strong> guides have full commons entries: click to open. Terms with at least one real source-guide definition point to a <strong>canonical source</strong> to consult.
  </p>

  <div class="stats-row" role="presentation">
    <div class="stat">
      <span class="stat-num" id="visible-count">{stats.visible_commons_rows.toLocaleString()}</span>
      <span class="stat-label" id="visible-label">terms shown</span>
    </div>
    <div class="stat">
      <span class="stat-num">{stats.visible_commons_rows}</span>
      <span class="stat-label">with full commons entries (≥3 sources)</span>
    </div>
    <div class="stat">
      <span class="stat-num">{stats.visible_canonical_rows.toLocaleString()}</span>
      <span class="stat-label">pointing to a canonical source</span>
    </div>
    <div class="stat">
      <span class="stat-num">{stats.visible_listed_rows.toLocaleString()}</span>
      <span class="stat-label">listed only</span>
    </div>
  </div>

  <div class="filters" role="group" aria-label="Filter terms by coverage">
    <button
      type="button"
      class="filter-chip active"
      data-filter="commons"
      data-count={stats.visible_commons_rows}
      aria-pressed="true"
    >
      Commons entries <span class="filter-num">{stats.visible_commons_rows}</span>
    </button>
    <button
      type="button"
      class="filter-chip"
      data-filter="all"
      data-count={stats.visible_rows}
      aria-pressed="false"
    >
      All terms <span class="filter-num">{stats.visible_rows.toLocaleString()}</span>
    </button>
    <button
      type="button"
      class="filter-chip"
      data-filter="long-tail"
      data-count={stats.visible_long_tail_rows}
      aria-pressed="false"
    >
      Long tail only <span class="filter-num">{stats.visible_long_tail_rows.toLocaleString()}</span>
    </button>
  </div>

  <div class="letters" role="navigation" aria-label="Jump to letter">
    {navLetters.map((letter) => (
      <a
        href={populatedLetters.has(letter) ? `#letter-${letter}` : undefined}
        class={`letter-link${populatedLetters.has(letter) ? "" : " empty"}`}
        aria-disabled={!populatedLetters.has(letter)}
      >
        {letter === "#" ? "#" : letter.toUpperCase()}
      </a>
    ))}
  </div>

  {letters.map((letter) => (
    <section class="alpha-section" id={`letter-${letter}`}>
      <h2 class="alpha-letter">{letter === "#" ? "#" : letter.toUpperCase()}</h2>
      <ul class="term-list">
        {by_letter[letter].map((termKey) => {
          const entry = rows[termKey];
          const hasCommons = entry.tier === "full" && !!entry.commons_slug;
          const canon = entry.canonical_source;
          const isCurated =
            entry.tier === "verified-hold" || entry.tier === "curated";
          const showInline = !hasCommons && entry.sources.length > 0;
          const aliases = entry.commons_slug ? (aliases_by_commons_slug[entry.commons_slug] ?? []) : [];
          return (
            <li
              class="term-row"
              id={termKey.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/-+/g, "-").replace(/^-|-$/g, "")}
              data-coverage={entry.source_count}
              data-is-commons={hasCommons ? "true" : "false"}
              data-tier={entry.tier}
            >
              <div class="term-main">
                {hasCommons ? (
                  <a class="term-name commons" href={`/terms/${entry.commons_slug}/`}>
                    {entry.display}
                    <span class="commons-marker" aria-label="commons entry">↗</span>
                  </a>
                ) : (
                  <span class="term-name">{entry.display}</span>
                )}
                <span class={`coverage-badge cov-${Math.min(entry.source_count, 5)}`}>
                  {entry.source_count} {entry.source_count === 1 ? "source" : "sources"}
                </span>
                {entry.tier === "verified-hold" && (
                  <span class="tier-tag verified" title="Hand-verified excerpt">verified</span>
                )}
                {entry.tier === "curated" && (
                  <span class="tier-tag curated" title="Excerpt extracted from the source's own glossary">from source glossary</span>
                )}
              </div>
              {aliases.length > 0 && (
                <p class="aliases">
                  Also indexed as:{" "}
                  {aliases.map((alias, index) => (
                    <span id={alias.term.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/-+/g, "-").replace(/^-|-$/g, "")}>
                      {alias.display}{index < aliases.length - 1 ? ", " : ""}
                    </span>
                  ))}
                </p>
              )}
              {isCurated && entry.excerpt && (
                <p class="curated-excerpt">“{entry.excerpt}”</p>
              )}
              {isCurated && (
                <p class="curated-meta">
                  {canon ? (
                    <>
                      Canonical source:{" "}
                      <a href={canon.source_page_url}>
                        {canon.org}{canon.year ? ` (${canon.year})` : ""}
                      </a>
                      {entry.canonical_archived && (
                        <span class="archived-hint"> · archived copy on the source page</span>
                      )}
                    </>
                  ) : (
                    <span class="archived-hint">canonical source currently unavailable</span>
                  )}
                </p>
              )}
              {isCurated && entry.note && (
                <p class="curated-note">{entry.note}</p>
              )}
              {showInline && (
                <details class="sources-detail">
                  <summary>Show {entry.sources.length === 1 ? "source" : "all sources"}</summary>
                  <ul class="sources-list">
                    {entry.sources.map((src) => (
                      <li class="source-row">
                        <a class="source-org" href={`/sources/${src.source_slug}/`}>
                          {src.org}
                        </a>
                        {src.year && <span class="source-year"> ({src.year})</span>}
                        {src.excerpt ? (
                          <span class="source-excerpt">: “{src.excerpt}”</span>
                        ) : (
                          <span class="source-excerpt-missing">: see source page for the full entry</span>
                        )}
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </li>
          );
        })}
      </ul>
    </section>
  ))}
</BaseLayout>

<script is:inline>
  (function () {
    const chips = document.querySelectorAll(".filter-chip");
    const visibleCount = document.getElementById("visible-count");
    const visibleLabel = document.getElementById("visible-label");
    const sections = document.querySelectorAll(".alpha-section");
    const root = document.documentElement;

    function applyFilter(filter) {
      root.dataset.glossaryFilter = filter;

      let total = 0;
      sections.forEach((section) => {
        const rows = section.querySelectorAll(".term-row");
        let visibleInSection = 0;
        rows.forEach((row) => {
          const isCommons = row.dataset.isCommons === "true";
          const show =
            filter === "all" ||
            (filter === "commons" && isCommons) ||
            (filter === "long-tail" && !isCommons);
          row.toggleAttribute("hidden", !show);
          if (show) visibleInSection++;
        });
        section.toggleAttribute("hidden", visibleInSection === 0);
        total += visibleInSection;
      });

      if (visibleCount) {
        visibleCount.textContent = total.toLocaleString();
      }
      if (visibleLabel) {
        const noun = total === 1 ? "term" : "terms";
        visibleLabel.textContent =
          filter === "all"
            ? `${noun} shown`
            : filter === "commons"
              ? `${noun} shown (commons only)`
              : `${noun} shown (long tail only)`;
      }
    }

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        chips.forEach((c) => {
          c.classList.remove("active");
          c.setAttribute("aria-pressed", "false");
        });
        chip.classList.add("active");
        chip.setAttribute("aria-pressed", "true");
        applyFilter(chip.dataset.filter || "all");
      });
    });

    // Apply the initially-active chip's filter on page load so the
    // default view matches the chip state.
    const initial = document.querySelector(".filter-chip.active");
    if (initial) {
      applyFilter(initial.dataset.filter || "all");
    }
  })();
</script>

<style>
  .subtitle {
    color: var(--ink-soft);
    font-size: 1rem;
    margin: 0 0 1.5rem;
    max-width: 50rem;
  }

  .stats-row {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    padding: 1rem 0 1.5rem;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 1.5rem;
  }
  .stat { display: flex; flex-direction: column; gap: 0.1rem; }
  .stat-num {
    font-family: "Charter", Georgia, serif;
    font-size: 1.8rem;
    font-weight: 500;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .stat-label { font-size: 0.85rem; color: var(--ink-muted); }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--rule);
    background: var(--bg-card, var(--bg));
    color: var(--ink);
    border-radius: 999px;
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 120ms ease, border-color 120ms ease, color 120ms ease;
  }
  .filter-chip:hover { border-color: var(--accent); color: var(--accent); }
  .filter-chip.active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }
  .filter-num {
    font-variant-numeric: tabular-nums;
    font-weight: 400;
    font-size: 0.85rem;
    opacity: 0.85;
  }
  .filter-chip.active .filter-num { color: var(--bg); }

  .letters {
    display: flex; flex-wrap: wrap; gap: 0.35rem;
    margin-bottom: 3rem; padding: 0.8rem 0;
    border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule);
    position: sticky; top: 0; background: var(--bg); z-index: 10;
  }
  .letter-link {
    display: inline-flex; align-items: center; justify-content: center;
    width: 28px; height: 28px;
    font-family: "Charter", Georgia, serif;
    font-weight: 500; font-size: 0.95rem; color: var(--ink);
    text-decoration: none; border-radius: 4px;
    transition: background 120ms ease, color 120ms ease;
  }
  .letter-link:hover { background: var(--bg-accent); color: var(--accent); }
  .letter-link.empty { color: var(--ink-muted); opacity: 0.4; pointer-events: none; }

  .alpha-section { margin-bottom: 2.5rem; }
  .alpha-letter {
    font-family: "Charter", Georgia, serif;
    font-size: 2.2rem; font-weight: 500; color: var(--accent);
    margin: 0 0 0.8rem;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 0.2rem; display: inline-block;
    min-width: 2.5rem; scroll-margin-top: 70px;
  }

  .term-list { list-style: none; padding: 0; margin: 0; }
  .term-row {
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--rule-soft);
  }
  .term-row:last-child { border-bottom: none; }

  .term-main {
    display: flex; gap: 0.8rem; align-items: baseline; flex-wrap: wrap;
  }
  .aliases {
    margin: 0.3rem 0 0;
    color: var(--ink-muted);
    font-size: 0.85rem;
  }
  .term-name {
    font-family: "Charter", Georgia, serif;
    font-size: 1.1rem; font-weight: 500; color: var(--ink);
  }
  .term-name.commons {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px dotted var(--accent-soft);
  }
  .term-name.commons:hover { border-bottom-style: solid; }
  .commons-marker {
    font-size: 0.75em; vertical-align: super; margin-left: 0.15rem;
    color: var(--accent-soft);
  }

  .coverage-badge {
    font-size: 0.7rem;
    font-weight: 500;
    padding: 0.12rem 0.45rem;
    border-radius: 10px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    background: var(--bg-accent);
    color: var(--ink-muted);
    white-space: nowrap;
  }
  .coverage-badge.cov-1 { background: #f0eae3; color: #8a7560; }
  .coverage-badge.cov-2 { background: #ece1d3; color: #74553a; }
  .coverage-badge.cov-3,
  .coverage-badge.cov-4,
  .coverage-badge.cov-5 {
    background: var(--accent);
    color: var(--bg);
  }

  .sources-detail { margin-top: 0.45rem; margin-left: 0.5rem; }
  .sources-detail summary {
    font-size: 0.82rem; color: var(--ink-muted); cursor: pointer;
    list-style: none; display: inline-block;
  }
  .sources-detail summary::before {
    content: "▸ "; display: inline-block; transition: transform 120ms ease;
  }
  .sources-detail[open] summary::before { content: "▾ "; }
  .sources-detail summary:hover { color: var(--accent); }

  .sources-list {
    list-style: none; padding: 0.5rem 0 0.2rem 0; margin: 0;
    font-size: 0.88rem; color: var(--ink-soft);
    border-left: 2px solid var(--rule-soft);
    padding-left: 0.8rem;
  }
  .source-row { padding: 0.25rem 0; line-height: 1.45; }
  .source-org { color: var(--accent); text-decoration: none; font-weight: 500; }
  .source-org:hover { text-decoration: underline; }
  .source-year { color: var(--ink-muted); font-variant-numeric: tabular-nums; }
  .source-excerpt { color: var(--ink-soft); font-style: italic; }
  .source-excerpt-missing { color: var(--ink-muted); font-style: italic; font-size: 0.9em; }

  /* Curated / verified-hold canonical-source blocks */
  .tier-tag {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.1rem 0.4rem;
    border-radius: 0.2rem;
    border: 1px solid var(--rule);
    color: var(--ink-muted);
    white-space: nowrap;
  }
  .tier-tag.verified { color: var(--accent); border-color: var(--accent-soft); }
  .curated-excerpt {
    margin: 0.35rem 0 0.2rem;
    color: var(--ink-soft);
    font-style: italic;
    font-size: 0.92rem;
    max-width: 52rem;
  }
  .curated-meta {
    margin: 0.15rem 0 0;
    font-size: 0.85rem;
    color: var(--ink-muted);
  }
  .curated-meta a { color: var(--accent); border-bottom: 1px dotted var(--accent-soft); text-decoration: none; }
  .curated-meta a:hover { border-bottom-style: solid; }
  .archived-hint { color: var(--ink-muted); font-style: italic; }
  .curated-note {
    margin: 0.2rem 0 0;
    font-size: 0.8rem;
    color: var(--ink-muted);
    max-width: 52rem;
  }
</style>
