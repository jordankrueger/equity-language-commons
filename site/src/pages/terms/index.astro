---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";

const all = await getCollection("terms");
const terms = all
  .filter((t) => !t.data.stub)
  .map((t) => ({
    slug: t.data.slug,
    term: t.data.term,
    href: `/terms/${t.data.slug}/`,
    aliases: t.data.aliases ?? [],
    tags: t.data.tags ?? [],
    guidanceCount: (t.data.guidance ?? []).length,
  }))
  .sort((a, b) => a.term.localeCompare(b.term, "en", { sensitivity: "base" }));

const LETTERS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("");

const groups = LETTERS.map((letter) => ({
  letter,
  items: terms.filter((t) => t.term[0]?.toUpperCase() === letter),
}));

const populatedLetters = new Set(groups.filter((g) => g.items.length > 0).map((g) => g.letter));
---

<BaseLayout
  title="A–Z index"
  description="Alphabetical index of every term in the Equity Language Commons."
  mainClass="wide"
>
  <Breadcrumb trail={[{ href: "/", label: "Home" }, { label: "A–Z index" }]} />
  <h1>A–Z index</h1>
  <p class="subtitle">{terms.length} term{terms.length === 1 ? "" : "s"} published across the commons.</p>

  <div class="letters" role="navigation" aria-label="Jump to letter">
    {LETTERS.map((letter) => (
      <a
        href={populatedLetters.has(letter) ? `#letter-${letter}` : undefined}
        class={`letter-link${populatedLetters.has(letter) ? "" : " empty"}`}
        aria-disabled={!populatedLetters.has(letter)}
      >
        {letter}
      </a>
    ))}
  </div>

  {groups
    .filter((g) => g.items.length > 0)
    .map((g) => (
      <section class="alpha-section" id={`letter-${g.letter}`}>
        <h2 class="alpha-letter">{g.letter}</h2>
        <ul class="term-list">
          {g.items.map((t) => (
            <li class="term-row">
              <div class="term-main">
                <a class="term-name" href={t.href}>{t.term}</a>
                {t.aliases.length > 0 && (
                  <span class="term-aliases">
                    also: {t.aliases.join(", ")}
                  </span>
                )}
              </div>
              <div class="term-meta">
                {t.guidanceCount} source{t.guidanceCount === 1 ? "" : "s"}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}
</BaseLayout>

<style>
  .subtitle { color: var(--ink-soft); font-size: 1rem; margin: 0 0 2rem; }
  .letters {
    display: flex; flex-wrap: wrap; gap: 0.35rem;
    margin-bottom: 3rem; padding: 0.8rem 0;
    border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule);
    position: sticky; top: 0; background: var(--bg); z-index: 10;
  }
  .letter-link {
    display: inline-flex; align-items: center; justify-content: center;
    width: 28px; height: 28px;
    font-family: "Charter", Georgia, serif;
    font-weight: 500; font-size: 0.95rem; color: var(--ink);
    text-decoration: none; border-radius: 4px;
    transition: background 120ms ease, color 120ms ease;
  }
  .letter-link:hover { background: var(--bg-accent); color: var(--accent); }
  .letter-link.empty { color: var(--ink-muted); opacity: 0.4; pointer-events: none; }

  .alpha-section { margin-bottom: 2.5rem; }
  .alpha-letter {
    font-family: "Charter", Georgia, serif;
    font-size: 2.2rem; font-weight: 500; color: var(--accent);
    margin: 0 0 0.8rem;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 0.2rem; display: inline-block;
    min-width: 2.5rem; scroll-margin-top: 70px;
  }
  .term-list { list-style: none; padding: 0; margin: 0; }
  .term-row {
    padding: 0.9rem 0; border-bottom: 1px solid var(--rule-soft);
    display: grid; grid-template-columns: 1fr auto;
    gap: 1rem; align-items: baseline;
  }
  .term-row:last-child { border-bottom: none; }
  .term-main { display: flex; gap: 0.8rem; align-items: baseline; flex-wrap: wrap; }
  .term-name {
    font-family: "Charter", Georgia, serif;
    font-size: 1.2rem; font-weight: 500; color: var(--accent);
    text-decoration: none; border-bottom: 1px dotted var(--accent-soft);
  }
  .term-name:hover { border-bottom-style: solid; }
  .term-aliases { font-size: 0.85rem; color: var(--ink-muted); font-style: italic; }
  .term-meta { font-size: 0.82rem; color: var(--ink-muted); font-variant-numeric: tabular-nums; }
</style>
