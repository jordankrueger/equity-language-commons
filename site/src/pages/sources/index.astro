---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { sourceAvailability } from "../../lib/sourceAvailability";

const all = await getCollection("sources");
const grouped = new Map<string, { slug: string; org: string; works: typeof all }>();
for (const source of all) {
  const slug = source.data.org_slug;
  const group = grouped.get(slug) ?? { slug, org: source.data.org, works: [] };
  group.works.push(source);
  grouped.set(slug, group);
}
const sources = [...grouped.values()]
  .map((group) => ({ ...group, works: group.works.sort((a, b) => b.data.year - a.data.year || a.id.localeCompare(b.id)) }))
  .sort((a, b) => a.org.localeCompare(b.org, "en", { sensitivity: "base" }));
---

<BaseLayout
  title="Sources"
  description="Every source organization cited in the Equity Language Commons."
>
  <Breadcrumb trail={[{ href: "/", label: "Home" }, { label: "Sources" }]} />
  <h1>Sources</h1>
  <p class="subtitle">{sources.length} source organization{sources.length === 1 ? "" : "s"} in the commons. Sources remain listed when an original moves or goes offline because commons entries still cite the reviewed edition.</p>
  <p class="status-help"><strong>Available online</strong> means the original is public. <strong>Reference copy held</strong> means it was reviewed from a private archival copy. <strong>Access restricted</strong> means the original requires a login or subscription.</p>

  <ul class="source-list">
    {sources.map((s) => (
      <li class="source-row">
        <div>
          <a class="org-name" href={`/sources/${s.slug}/`}>{s.org}</a>
          {s.works.map((work) => (
            <p class="work">{work.data.work_title} <span class="year">({work.data.year})</span></p>
          ))}
        </div>
        <div class="posture">
          {s.works.map((work) => <span class="chip">{sourceAvailability(work.data)}</span>)}
        </div>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .subtitle { color: var(--ink-soft); font-size: 1rem; margin: 0 0 2rem; }
  .status-help { background: var(--bg-card); border: 1px solid var(--rule); padding: 0.9rem 1rem; margin: -0.75rem 0 2rem; font-size: 0.9rem; }
  .source-list { list-style: none; padding: 0; margin: 0; }
  .source-row {
    padding: 1rem 0; border-bottom: 1px solid var(--rule-soft);
    display: grid; grid-template-columns: 1fr auto;
    gap: 1rem; align-items: baseline;
  }
  .source-row:last-child { border-bottom: none; }
  .org-name {
    font-family: "Charter", Georgia, serif;
    font-weight: 500; font-size: 1.15rem; color: var(--accent);
    text-decoration: none; border-bottom: 1px dotted var(--accent-soft);
  }
  .org-name:hover { border-bottom-style: solid; }
  .work { margin: 0.2rem 0 0; font-size: 0.95rem; color: var(--ink-soft); }
  .work .year { color: var(--ink-muted); font-variant-numeric: tabular-nums; }
  .posture {
    display: flex; flex-direction: column; gap: 0.35rem;
    align-items: flex-end;
    font-size: 0.72rem;
    text-transform: uppercase; letter-spacing: 0.06em;
    text-align: right;
  }
  .chip {
    display: inline-block;
    padding: 0.18rem 0.55rem;
    border-radius: 3px;
    line-height: 1.4;
    white-space: nowrap;
    font-weight: 500;
    background: var(--bg-card, #f5f1ea);
    border: 1px solid var(--rule, #d8d2c4);
    color: var(--ink-soft, #4a463c);
  }
</style>
