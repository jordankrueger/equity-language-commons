---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import RecBadge from "../../components/RecBadge.astro";
import { sourceAvailability } from "../../lib/sourceAvailability";

export async function getStaticPaths() {
  const sources = await getCollection("sources");
  const terms = await getCollection("terms");
  const groups = new Map<string, typeof sources>();
  for (const source of sources) {
    const group = groups.get(source.data.org_slug) ?? [];
    group.push(source);
    groups.set(source.data.org_slug, group);
  }
  return [...groups.entries()].map(([orgSlug, works]) => {
    works.sort((a, b) => b.data.year - a.data.year || a.id.localeCompare(b.id));
    const source = works.find((work) => work.id === orgSlug) ?? works[0];
    const citing = terms
      .filter((t) =>
        (t.data.guidance ?? []).some((g) => g.org_slug === orgSlug)
      )
      .map((t) => {
        const matches = (t.data.guidance ?? []).filter(
          (g) => g.org_slug === orgSlug
        );
        return matches.map((m) => ({
          slug: t.data.slug,
          term: t.data.term,
          recommendation: m.recommendation,
          quote: m.quote,
          quote_loc: m.quote_loc,
        }));
      })
      .flat();
    return {
      params: { slug: orgSlug },
      props: { source, works, citing },
    };
  });
}

const { source, works, citing } = Astro.props;
const data = source.data;
const { Content } = await render(source);

---

<BaseLayout
  title={data.org}
  description={`${data.org}: source works cited in the Equity Language Commons.`}
  pagefind
>
  <Breadcrumb
    trail={[
      { href: "/", label: "Home" },
      { href: "/sources/", label: "Sources" },
      { label: data.org },
    ]}
  />

  <p class="kicker">Source</p>
  <h1 class="source">{data.org}</h1>
  <div class="access-panel"><Content /></div>

  <h2>Works reviewed</h2>
  {works.map((work) => {
    const item = work.data;
    const addedDate = item.added ? new Date(item.added).toLocaleDateString("en-US", { month: "long", year: "numeric" }) : null;
    return (
      <section class="work-card">
        <div class="work-heading"><h3>{item.work_title}</h3><span class="chip">{sourceAvailability(item)}</span></div>
        <dl class="meta-grid">
          <dt>Published</dt><dd>{item.year}</dd>
          {item.format && (<><dt>Format</dt><dd>{item.format}</dd></>)}
          {item.length_pages && (<><dt>Length</dt><dd>{item.length_pages} pages{item.length_sections ? `, ${item.length_sections} sections` : ""}</dd></>)}
          {item.copyright_holder && (<><dt>Copyright</dt><dd>&copy; {item.copyright_holder}{item.license ? `: ${item.license}` : ". No reuse license stated."}</dd></>)}
          {item.source_url && (<><dt>Original</dt><dd><a href={item.source_url} rel="noopener">Open source</a></dd></>)}
          {addedDate && (<><dt>Added</dt><dd>{addedDate}</dd></>)}
        </dl>
      </section>
    );
  })}

  {data.version_history?.length > 0 && (
    <>
      <h2>Version history</h2>
      <ul class="version-history">
        {data.version_history.map((v, i) => (
          <li class="version-item">
            <div class="version-head">
              <span class="version-year">{v.year} edition</span>
              {i === 0 && <span class="version-label current">Current canonical</span>}
            </div>
            <p class="version-note">{v.note}</p>
          </li>
        ))}
      </ul>
    </>
  )}

  <h2>Terms citing this source</h2>
  {citing.length === 0 ? (
    <p class="empty">No published terms currently cite this source.</p>
  ) : (
    <ul class="citing-list">
      {citing.map((c) => (
        <li class="citing-term">
          <div class="citing-head">
            <a class="citing-term-name" href={`/terms/${c.slug}/`}>{c.term}</a>
            <RecBadge value={c.recommendation} />
          </div>
          {c.quote && <blockquote class="citing-quote">&ldquo;{c.quote}&rdquo;</blockquote>}
          <p class="citing-loc">: {c.quote_loc}</p>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>

<style>
  h1.source {
    font-family: "Charter", Georgia, serif;
    font-size: 3.2rem; font-weight: 500;
    line-height: 1.05; margin: 0 0 0.3rem;
    letter-spacing: -0.01em;
  }
  .access-panel {
    background: var(--bg-warn);
    border-left: 4px solid var(--warn);
    border-radius: 4px;
    padding: 1.3rem 1.5rem;
    margin-bottom: 2.5rem;
  }
  .chip {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 3px;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1.4;
    font-weight: 500;
    white-space: nowrap;
  }
  .chip { background: var(--bg-card); border: 1px solid var(--rule); color: var(--ink-soft); }

  .meta-grid {
    background: var(--bg-card);
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 1.3rem 1.5rem;
    display: grid;
    grid-template-columns: max-content 1fr;
    column-gap: 2rem;
    row-gap: 0.6rem;
    font-size: 0.93rem;
  }
  .meta-grid dt {
    font-family: "Charter", Georgia, serif;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    font-weight: 500;
    align-self: center;
  }
  .meta-grid dd { margin: 0; color: var(--ink); }
  .meta-grid a { color: var(--accent); text-decoration: none; border-bottom: 1px solid var(--accent-soft); }

  .version-history { list-style: none; padding: 0; margin: 0; }
  .version-item { padding: 1rem 0; border-bottom: 1px solid var(--rule-soft); }
  .version-item:last-child { border-bottom: none; }
  .version-head { display: flex; gap: 0.8rem; align-items: baseline; margin-bottom: 0.4rem; }
  .version-year { font-family: "Charter", Georgia, serif; font-weight: 500; font-size: 1.05rem; }
  .version-label.current {
    font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--use-ink); background: var(--use-bg);
    padding: 0.1rem 0.5rem; border-radius: 3px; font-weight: 500;
  }
  .version-note { margin: 0; color: var(--ink-soft); font-size: 0.95rem; }

  .citing-list { list-style: none; padding: 0; margin: 0; }
  .citing-term {
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--rule-soft);
  }
  .citing-term:last-child { border-bottom: none; }
  .citing-head { display: flex; gap: 0.8rem; align-items: baseline; margin-bottom: 0.6rem; flex-wrap: wrap; }
  .citing-term-name {
    font-family: "Charter", Georgia, serif;
    font-weight: 500; font-size: 1.1rem;
    color: var(--accent); text-decoration: none;
    border-bottom: 1px dotted var(--accent-soft);
  }
  .citing-quote {
    font-family: "Charter", Georgia, serif;
    font-style: italic; font-size: 1rem; line-height: 1.55;
    border-left: 3px solid var(--accent);
    padding-left: 1rem; margin: 0.6rem 0;
    color: var(--ink);
  }
  .citing-loc { font-size: 0.85rem; color: var(--ink-muted); font-style: italic; margin: 0; }
  .empty { color: var(--ink-muted); font-style: italic; }
</style>
