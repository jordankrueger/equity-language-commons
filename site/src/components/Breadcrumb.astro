---
interface Crumb {
  href?: string;
  label: string;
}

interface Props {
  trail: Crumb[];
}

const { trail } = Astro.props;
---

<p class="breadcrumb">
  {trail.map((c, i) => {
    const isLast = i === trail.length - 1;
    return (
      <>
        {c.href && !isLast ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
        {!isLast && <span aria-hidden="true"> &nbsp;/&nbsp; </span>}
      </>
    );
  })}
</p>
